# Copy to .env and fill in every value. Never commit .env.
# Avoid ';' and '$' in values: ';' ends a field of the connection string, '$' is expanded by Compose.

# --- Database: an existing PostgreSQL. Create the database and its user there first. ---
# Docker network that the database container is on. 1Panel uses "1panel-network".
DB_NETWORK=1panel-network
# Container name of the database on that network (1Panel: Databases -> PostgreSQL -> connection info).
DB_HOST=
DB_PORT=5432
DB_NAME=erp
DB_USER=erp
DB_PASSWORD=

# Signs login tokens. 32+ random characters, e.g. `openssl rand -hex 32`. Changing it signs everyone out.
JWT_KEY=

# Password of the first `admin` user, 12+ characters. Used only when the users table is empty:
# after the first start, sign in, change it on the 修改密码 page, delete this line and run
# `docker compose up -d` again, so it is no longer readable in the container's environment.
ADMIN_PASSWORD=

# Private subnet of this stack's own network (web + api). Pick one no other Docker network uses
# (`docker network inspect $(docker network ls -q) | grep Subnet`). Changing it needs `docker compose down` first.
APP_SUBNET=172.30.99.0/24

# Port on 127.0.0.1 that the host's reverse proxy forwards to.
WEB_PORT=8080
